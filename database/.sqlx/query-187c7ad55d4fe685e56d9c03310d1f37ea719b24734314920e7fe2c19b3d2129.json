{
  "db_name": "MySQL",
  "query": "\n                SELECT\n                    `id` AS `comic_id`,\n                    `title`,\n                    DATE_FORMAT(`publish_date`, '%Y-%m-%d') AS `pub_date`,\n                    `is_guest_comic`,\n                    `is_non_canon`\n                FROM `v_visible_comic`\n                WHERE `id` = 1\n                   OR (`id` >= 100 AND `id` <= 1000 AND `id` % 100 = 0)\n                   OR (`id` > 1000 AND `id` % 500 = 0)\n                ORDER BY `id`\n            ",
