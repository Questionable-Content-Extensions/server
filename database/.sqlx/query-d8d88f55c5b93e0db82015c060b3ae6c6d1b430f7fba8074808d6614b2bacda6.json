{
  "db_name": "MySQL",
  "query": "\n                SELECT\n                    `i2`.`id`,\n                    `i2`.`short_name`,\n                    `i2`.`name`,\n                    `i2`.`type`,\n                    `i2`.`color_blue`,\n                    `i2`.`color_green`,\n                    `i2`.`color_red`,\n                    COUNT(`i2`.`id`) as `count`\n                FROM `Item` `i`\n                JOIN `v_visible_occurrence` `o` ON `i`.`id` = `o`.`item_id`\n                JOIN `v_visible_occurrence` `o2` ON `o`.`comic_id` = `o2`.`comic_id`\n                JOIN Item `i2` ON `o2`.`item_id` = `i2`.`id`\n                WHERE `i`.`id` = ?\n                    AND `i2`.`id` <> `i`.`id`\n                    AND `i2`.`type` = ?\n                GROUP BY `i2`.`id`\n                ORDER BY `count` DESC\n                LIMIT ?\n            ",
