  "query": "\n                SELECT\n                    YEAR(`publish_date`) AS `year`,\n                    MONTH(`publish_date`) AS `month`,\n                    COUNT(*) AS `comics`\n                FROM `v_visible_comic`\n                WHERE `publish_date` IS NOT NULL\n                GROUP BY YEAR(`publish_date`), MONTH(`publish_date`)\n                ORDER BY `year`, `month`\n            ",
