  "query": "\n                SELECT\n                    YEAR(`publish_date`) AS `year`,\n                    HOUR(`publish_date`) AS `hour`,\n                    COUNT(*) AS `comics`\n                FROM `v_visible_comic`\n                WHERE `publish_date` IS NOT NULL\n                GROUP BY YEAR(`publish_date`), HOUR(`publish_date`)\n                ORDER BY `year`, `hour`\n            ",
