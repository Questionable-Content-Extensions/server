{
  "db_name": "MySQL",
  "query": "\n                SELECT\n                    `i`.`id`,\n                    `i`.`name`,\n                    MIN(`o`.`comic_id`) AS `first_comic`,\n                    MAX(`o`.`comic_id`) AS `last_comic`,\n                    COUNT(*) AS `appearances`\n                FROM `Item` `i`\n                JOIN `v_visible_occurrence` `o` ON `i`.`id` = `o`.`item_id`\n                WHERE `i`.`type` = 'location'\n                GROUP BY `i`.`id`\n                ORDER BY `appearances` DESC, `i`.`id`\n            ",
