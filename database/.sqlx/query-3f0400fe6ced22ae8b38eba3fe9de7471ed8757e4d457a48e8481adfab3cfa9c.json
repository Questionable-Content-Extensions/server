  "query": "\n                SELECT\n                    YEAR(`publish_date`) AS `year`,\n                    DAYOFWEEK(`publish_date`) AS `dow`,\n                    COUNT(*) AS `comics`\n                FROM `v_visible_comic`\n                WHERE `publish_date` IS NOT NULL\n                GROUP BY YEAR(`publish_date`), DAYOFWEEK(`publish_date`)\n                ORDER BY `year`, `dow`\n            ",
