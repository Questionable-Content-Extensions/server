  "db_name": "MySQL",
  "query": "\n                SELECT\n                    `i`.`id`,\n                    `i`.`short_name`,\n                    `i`.`name`,\n                    `i`.`type`,\n                    `i`.`color_blue`,\n                    `i`.`color_green`,\n                    `i`.`color_red`,\n                    `i`.`primary_image`,\n                    `i`.`start_comic_id`,\n                    `i`.`end_comic_id`,\n                    COUNT(`o`.`comic_id`) AS `count`\n                FROM `Item` `i`\n                LEFT JOIN `v_visible_occurrence` `o` ON `o`.`item_id` = `i`.`id`\n                GROUP BY `i`.`id`\n                ORDER BY `count` DESC\n            ",
